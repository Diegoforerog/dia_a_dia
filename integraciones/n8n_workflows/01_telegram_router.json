        [{"node": "Construir menú", "type": "main", "index": 0}],
        [{"node": "Construir menú", "type": "main", "index": 0}]
      ]
    },
    "Obtener plan hoy": {"main": [[{"node": "Formatear plan", "type": "main", "index": 0}]]},
    "Formatear plan": {"main": [[{"node": "Enviar a Telegram", "type": "main", "index": 0}]]},

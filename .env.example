# Plantilla de variables de entorno para producción
# Copia a .env y rellena con tus valores reales (NO subir .env al repo)

# OpenAI — para el planificador IA
OPENAI_API_KEY=sk-...

# Token de la API (cualquier string largo y aleatorio)
ORGANIZADOR_TOKEN=cambia-esto-por-algo-largo-y-secreto

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n
N8N_URL=https://n8n2.nextgencol.com
N8N_API_TOKEN=

# PostgreSQL
DB_HOST=easy.nextgencol.com
DB_PORT=10433
DB_NAME=nextgen
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=organizador

# Puerto donde escucha la API (Easypanel lo setea automáticamente)
PORT=5050

# (Opcional, solo si usas OAuth de Google Calendar)
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/oauth/google/callback
